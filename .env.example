# ------------------------------------------------------------------
# Campus Found frontend — environment
# ------------------------------------------------------------------
# Leave VITE_API_URL empty when the backend is reachable on the same
# origin (dev via Vite proxy, or production where the SPA is served
# from the backend). Set it when frontend and backend run on
# DIFFERENT hosts, e.g.:
#   VITE_API_URL=https://campus-found-api.onrender.com
# Socket.IO uses the same origin automatically.
VITE_API_URL=

# Port for the Vite dev server (optional)
VITE_PORT=5173
